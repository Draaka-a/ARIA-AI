# Which provider to use — must match a file in providers/ (without .js)
AI_PROVIDER=openrouter

# --- OpenRouter (active) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
# Optional, just for attribution in your OpenRouter dashboard:
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=ARIA Assistant

# --- Anthropic (kept here in case you switch back later) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Deepgram (streaming speech-to-text, used by /ws/stt) ---
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_MODEL=nova-3

# Port the local server listens on
PORT=8000
